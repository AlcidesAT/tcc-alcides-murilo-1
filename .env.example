# ===========================================================================
# Variáveis de ambiente — copie este arquivo para ".env" e ajuste os valores.
# O .env é carregado automaticamente pelo backend (python-dotenv).
# ===========================================================================

# Conexão com o PostgreSQL.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# No Docker esta linha é ignorada: o docker-compose monta a conexão com o
# container do banco a partir das variáveis POSTGRES_* abaixo.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tcc_rag

# Docker (docker-compose.yml). POSTGRES_PASSWORD é obrigatória para subir os
# containers; use só letras e números (ela entra na URL de conexão).
# APP_PORT é a porta do servidor onde o sistema fica acessível.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=tcc_rag
APP_PORT=8000

# Perfis de acesso. O perfil Leitor é o padrão e não exige login.
#  - Administrador: envio/gestão de artigos e acesso aos dados coletados.
#  - Login da turma: usado por todos os participantes dos testes; registra
#    perguntas, respostas, notas e o questionário no banco (sessões anônimas).
# Defina as senhas SÓ no seu .env (ele fica fora do Git). Sem senha, aquele
# login fica desativado.
ADMIN_USER=admin
ADMIN_PASSWORD=
PARTICIPANT_USER=turma
PARTICIPANT_PASSWORD=

# Modelos do Ollama (opcionais — os valores abaixo são os padrões).
# Trocar LLM_MODEL permite comparar modelos na avaliação de precisão
# (python evaluate.py e o painel "Coleta da pesquisa").
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2:1b
# LLM_TEMPERATURE=0.2
# EMBEDDING_MODEL=nomic-embed-text
